# Django Settings
SECRET_KEY='your-secret-key-here'
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Email Configuration (for password reset)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL="Comunidade T.E.I.A <your-email@gmail.com>"

# LLM Provider Configuration
# Options: local, unb, gemini
LLM_PROVIDER=local

# Local LLM (Ollama) - used when LLM_PROVIDER=local
LOCAL_LLM_URL=http://127.0.0.1:11434/v1
# Modelo Ollama a ser usado (ex: qwen3:8b, llama3.1:8b, mistral:7b)
# Deve corresponder a um modelo instalado no Ollama (ollama pull <modelo>)
LOCAL_LLM_MODEL=qwen3:8b

# UnB LiteLLM Router - used when LLM_PROVIDER=unb
UNB_LLM_URL=https://ia-router.unb.br/v1/
UNB_LLM_MODEL=UnB-Llama-3.3-70B-Instruct
UNB_API_KEY=your-unb-api-key

# Google Gemini - used when LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173