# Django
SECRET_KEY=gere-uma-chave-com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,seu-dominio.com

# CORS / CSRF (produção: adicione seu domínio HTTPS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# E-mail (App Password Gmail - NÃO a senha da conta)
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-app-password-de-16-chars
DEFAULT_FROM_EMAIL="Nome do Sistema" <seu-email@gmail.com>

# LLM Provider: 'local' (Ollama), 'unb' (LiteLLM UnB), ou 'gemini'
LLM_PROVIDER=local
GEMINI_API_KEY=sua-chave-gemini-aqui

# Configurações do modelo local (Ollama)
LOCAL_LLM_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen3:8b
LOCAL_LLM_TIMEOUT=90

# Configurações do provedor UnB (LiteLLM)
UNB_LLM_URL=https://ia-router.unb.br/v1/
UNB_LLM_MODEL=UnB-Llama-3.3-70B-Instruct
UNB_API_KEY=sua-chave-unb-aqui

# Frontend URL (para links de reset de senha)
FRONTEND_URL=http://localhost:5173

# Throttle scopes (opcional - valores padrão definidos no settings.py)
# THROTTLE_AI_CATALOG=20/h
# THROTTLE_AI_PLANNER=10/h
# THROTTLE_PASSWORD_RESET_REQUEST=3/h
# THROTTLE_PASSWORD_RESET_CONFIRM=5/h
# THROTTLE_REGISTER=5/h